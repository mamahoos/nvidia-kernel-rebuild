#!/usr/bin/env bash
# Called by apt after package installs when kernel or NVIDIA DKMS packages change.
# Install path is set by install.sh.

set -euo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=nvidia-kernel-rebuild-lib.sh
source "${SCRIPT_DIR}/nvidia-kernel-rebuild-lib.sh"

REBUILD=/usr/local/sbin/nvidia-kernel-rebuild.sh

nvidia_dkms_registered || exit 0

if apt_recent_nvidia_driver_change; then
    KV="$(get_newest_installed_kernel || true)"
elif apt_recent_kernel_change; then
    KV="$(get_newest_kernel_missing_nvidia || true)"
else
    exit 0
fi

[[ -n "${KV:-}" ]] || exit 0

schedule_rebuild "apt-hook" "$REBUILD" "$KV" || exit 0
